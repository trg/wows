---
import NavBar from '../components/NavBar.astro';
import { base } from '../lib/base';
import '../styles/global.css';

interface Props {
  title: string;
  backHref?: string;
  backLabel?: string;
}

const { title, backHref, backLabel } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title} · WoWS Legends Companion</title>
    <meta name="description" content="Loadouts, tips, and playstyle notes for World of Warships: Legends." />
    <link
      rel="preload"
      href={`${base}fonts/staatliches.woff2`}
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href={`${base}fonts/ibm-plex-sans-400.woff2`}
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link rel="icon" href={`${base}favicon.svg`} type="image/svg+xml" />
  </head>
  <body>
    <main>
      {backHref && (
        <a class="back-link" href={backHref}>&larr; {backLabel ?? 'Back'}</a>
      )}
      <slot />
    </main>
    <NavBar />
    <footer class="disclaimer">
      <a href={`${base}disclaimer/`}>Disclaimer</a>
    </footer>
  </body>
</html>

<style>
  .disclaimer {
    max-width: 720px;
    margin: 0 auto;
    padding: 0 var(--space-4) calc(var(--nav-height) + var(--space-4));
    font-size: 0.75rem;
    color: var(--color-text-muted);
  }

  @media (min-width: 640px) {
    .disclaimer {
      padding-left: var(--space-6);
      padding-right: var(--space-6);
    }
  }
</style>
