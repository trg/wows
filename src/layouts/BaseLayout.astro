---
import NavBar from '../components/NavBar.astro';
import { base, withBase } from '../lib/base';
import '../styles/global.css';

interface Props {
  title: string;
  backHref?: string;
  backLabel?: string;
  description?: string;
  image?: string;
  type?: 'website' | 'article';
}

const SITE_NAME = 'WoWS Legends Companion';
const DEFAULT_DESCRIPTION = 'Loadouts, tips, and playstyle notes for World of Warships: Legends.';

const { title, backHref, backLabel, type = 'website' } = Astro.props;
const description = Astro.props.description ?? DEFAULT_DESCRIPTION;
const image = Astro.props.image ?? 'og-default.png';
const absoluteImage = new URL(withBase(image.replace(/^\//, '')), Astro.site).href;
const canonicalUrl = Astro.url.href;
const fullTitle = `${title} · ${SITE_NAME}`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />

    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={absoluteImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={absoluteImage} />

    <link
      rel="preload"
      href={`${base}fonts/staatliches.woff2`}
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href={`${base}fonts/ibm-plex-sans-400.woff2`}
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link rel="icon" href={`${base}favicon.svg`} type="image/svg+xml" />
    <link rel="apple-touch-icon" href={`${base}icons/apple-touch-icon.png`} />
    <link rel="manifest" href={`${base}manifest.webmanifest`} />
    <meta name="theme-color" content="#0a0f0b" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="apple-mobile-web-app-title" content="WoWS Legends" />
  </head>
  <body>
    <header class="site-header">
      <NavBar />
    </header>
    <main>
      {backHref && (
        <a class="back-link" href={backHref}>&larr; {backLabel ?? 'Back'}</a>
      )}
      <slot />
    </main>
    <footer class="disclaimer">
      <a href={`${base}about/`}>About</a>
    </footer>
  </body>
</html>

{/*
  @font-face src paths must resolve through `base` here rather than living as
  hardcoded /fonts/... urls in global.css: Vite only rewrites public-dir url()
  references with the configured base during the production build, so a plain
  absolute path 404s in dev even though it works once built. This can't use
  define:vars (CSS custom properties) because @font-face descriptors don't
  support var() substitution per spec — lightningcss silently drops the whole
  src line. set:html injects the already-resolved path as a plain string.
*/}
<style set:html={`
  @font-face {
    font-family: 'Staatliches';
    font-style: normal;
    font-weight: 400;
    font-display: swap;
    src: url('${base}fonts/staatliches.woff2') format('woff2');
  }

  @font-face {
    font-family: 'IBM Plex Sans';
    font-style: normal;
    font-weight: 400;
    font-display: swap;
    src: url('${base}fonts/ibm-plex-sans-400.woff2') format('woff2');
  }
`} />

<style>
  .disclaimer {
    max-width: 720px;
    margin: 0 auto;
    padding: 0 var(--space-4) var(--space-4);
    font-size: 0.75rem;
    color: var(--color-text-muted);
  }

  @media (min-width: 640px) {
    .disclaimer {
      padding-left: var(--space-6);
      padding-right: var(--space-6);
    }
  }
</style>
