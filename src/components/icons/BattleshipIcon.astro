  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.5"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
>
  <path d="M1 15 L3 15 L4 11 L20 11 L23 15 L20 17 L4 17 Z" />
  <rect x="5" y="8" width="3" height="3" />
  <rect x="16" y="8" width="3" height="3" />
  <rect x="10" y="5" width="4" height="6" />
</svg>
